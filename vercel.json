{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "intelligence",
          "format": "url",
          "env": "INTELLIGENCE_URL"
        }
      ]
    },
    "intelligence": {
      "root": "services/intelligence",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/intelligence/(.*)",
      "destination": { "service": "intelligence" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
