{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "services",
  "services": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/"
    },
    "intelligence": {
      "entrypoint": "services/intelligence/app/main.py",
      "routePrefix": "/intelligence",
      "framework": "fastapi",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": [
        "services/intelligence/models/**"
      ]
    }
  }
}
